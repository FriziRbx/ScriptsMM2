local function norm(s)
    return (tostring(s or ""):lower():gsub("[^%w]", ""))
end
-- Preserve spelling for exact matches; compact keys are a fallback only.
local function exactName(s)
    return (tostring(s or ""):lower():match("^%s*(.-)%s*$"):gsub("%s+", " "))
end
local function hasWord(s, word)
    return s:match("%f[%a]"..word.."%f[%A]") ~= nil
end
local function nameParts(name)
    local s=exactName(name)
    local chroma=s:match("^chroma%s+") ~= nil
    if chroma then s=s:gsub("^chroma%s+", "", 1) end
    local kind
    if hasWord(s,"gun") then kind="gun" end
    if hasWord(s,"knife") then kind=kind and "conflict" or "knife" end
    local year=s:match("%f[%d](20%d%d)%f[%D]")
    local base=s:gsub("%s*%(%s*gun%s*%)%s*$", "")
    base=base:gsub("%s*%(%s*knife%s*%)%s*$", "")
    base=base:gsub("%s*%(%s*20%d%d%s*%)%s*$", "")
    base=base:gsub("%s*%[%s*20%d%d%s*%]%s*$", "")
    return exactName(base), kind, year, chroma
end
local index = {}
for _,entry in pairs(items) do
    local name=type(entry)=="table" and entry.name
    if type(name)=="string" and entry.category ~= nil then
        local base,kind,year,chroma=nameParts(name)
        kind=entry.type ~= NULL_VALUE and entry.type or kind
        year=entry.year ~= NULL_VALUE and entry.year or year
        local key=norm(base)
        if key ~= "" then
            index[key]=index[key] or {}
            table.insert(index[key],{name=name, entry=entry, base=base, kind=kind, year=year, chroma=chroma})
        end
    end
end
-- Check every ancestor, including ScreenGui.Enabled, not just the slot.
local function isVisible(obj)
    local rect
    if obj and obj:IsA("GuiObject") then
        local p,s=obj.AbsolutePosition,obj.AbsoluteSize
        if s.X <= 0 or s.Y <= 0 then return false end
        rect={p.X,p.Y,p.X+s.X,p.Y+s.Y}
    end
    local node=obj
    while node do
        if node:IsA("GuiObject") then
            if not node.Visible then return false end
            if rect and node ~= obj and (node.ClipsDescendants or node:IsA("ScrollingFrame")) then
                local p,s=node.AbsolutePosition,node.AbsoluteSize
                rect[1]=math.max(rect[1],p.X); rect[2]=math.max(rect[2],p.Y)
                rect[3]=math.min(rect[3],p.X+s.X); rect[4]=math.min(rect[4],p.Y+s.Y)
                if rect[1]>=rect[3] or rect[2]>=rect[4] then return false end
            end
        end
        if node:IsA("LayerCollector") and not node.Enabled then return false end
        node=node.Parent
    end
    local camera=workspace.CurrentCamera
    if rect and camera then
        local v=camera.ViewportSize
        if rect[3]<=0 or rect[4]<=0 or rect[1]>=v.X or rect[2]>=v.Y then return false end
    end
    return true
end
local function visibleWithin(obj, ancestor)
    local node=obj
    while node and node ~= ancestor do
        if node:IsA("GuiObject") and not node.Visible then return false end
        node=node.Parent
    end
    return node == ancestor and (not ancestor:IsA("GuiObject") or ancestor.Visible)
end
local function getText(obj)
    if obj and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return obj.Text end
end
local function childPath(obj,...)
    for _,name in ipairs({...}) do obj=obj and obj:FindFirstChild(name) end
    return obj
end
-- Only visible label/tag text is currently documented evidence. No Image,
-- color, symbol or attribute is interpreted without a verified adapter.
local function resolve(name, container)
    local base, labelKind, labelYear, labelChroma=nameParts(name)
    local evidence={kind=nil, year=nil, chroma=labelChroma and true or nil, conflict=false}
    local function add(field, value)
        if not value then return end
        if value=="conflict" or (evidence[field] and evidence[field]~=value) then
            evidence.conflict=true
        else evidence[field]=value end
    end
    add("kind",labelKind)
    for year in exactName(name):gmatch("%f[%d](20%d%d)%f[%D]") do add("year",year) end
    -- Only explicitly named weapon-type attributes on this slot are evidence.
    -- Ignore undocumented values, image IDs, colours and unrelated attributes.
    for _,object in ipairs({container, container.Parent}) do
        if object and object.GetAttribute then
            for _,key in ipairs({"ItemType", "WeaponType"}) do
                local ok, raw=pcall(function() return object:GetAttribute(key) end)
                if ok and type(raw)=="string" then
                    local value=exactName(raw)
                    if value=="gun" or value=="knife" then add("kind",value) end
                end
            end
        end
    end
    local tags=container:FindFirstChild("Tags")
    if tags then
        -- Nested text labels are common; only this bounded subtree is visited.
        local function inspect(node)
            if not visibleWithin(node,container) then return end
            if node:IsA("GuiObject") then
                if not isVisible(node) then return end
                for _,raw in ipairs({node.Name, getText(node) or ""}) do
                    local text=exactName(raw)
                    if text=="chroma" then add("chroma",true) end
                    if text=="gun" or text=="knife" then add("kind",text) end
                    if text:match("^20%d%d$") then add("year",text) end
                end
            end
            for _,child in ipairs(node:GetChildren()) do inspect(child) end
        end
        inspect(tags)
    end
    if evidence.conflict then return "?" end
    if not evidence.chroma and not evidence.year and (exactName(name)=="default knife" or exactName(name)=="default gun") then return "0" end
    local candidates=index[norm(base)]
    if not candidates then return "?" end
    -- Prefer literal base spelling over compact collisions, but never drop
    -- variants of that base merely because their suffix is absent from the UI.
    local exact={}
    for _,v in ipairs(candidates) do
        if v.base==base then table.insert(exact,v) end
    end
    if #exact>0 then candidates=exact end
    -- A chroma tag explicitly selects Chroma; otherwise the literal name is
    -- non-Chroma. Never merge prices across the Chroma token boundary.
    local matches={}
    for _,v in ipairs(candidates) do
        if ((evidence.chroma and v.chroma) or (not evidence.chroma and not v.chroma))
            and (not evidence.kind or not v.kind or v.kind==evidence.kind)
            and (not evidence.year or not v.year or v.year==evidence.year) then
            table.insert(matches,v)
        end
    end
    if #matches == 0 then return "?" end
    -- Compact spelling is only safe when it identifies one literal base.
    -- Equal prices do not make differently spelled item names identical.
    local literalBase, value = matches[1].base, nil
    for _,match in ipairs(matches) do
        if match.base ~= literalBase then return "?" end
        local current=match.entry.value
        if type(current) ~= "number" or current < 0 or current ~= current or current == math.huge then return "?" end
        if value ~= nil and value ~= current then return "?" end
        value=current
    end
    return tostring(value)
end
local function amountOf(container, slot)
    local amount=container:FindFirstChild("Amount") or slot:FindFirstChild("Amount")
    if not amount or not visibleWithin(amount,slot) then return 1 end
    local text=getText(amount)
    if not text then
        for _,o in ipairs(amount:GetChildren()) do if visibleWithin(o,slot) and getText(o) then text=getText(o); break end end
    end
    if not text or text:match("^%s*$") then return 1 end
    local raw=text:match("^%s*[xX]%s*([%d,]+)%s*$") or text:match("^%s*([%d,]+)%s*[xX]%s*$") or text:match("^%s*([%d,]+)%s*$")
    if not raw then return nil end
    if raw:find(",",1,true) then
        local first,rest=raw:match("^(%d%d?%d?)(,.*)$")
        if not first then return nil end
        while #rest>0 do
            local group=rest:match("^,(%d%d%d)")
            if not group then return nil end
            rest=rest:sub(5)
        end
    end
    local number=tonumber((raw:gsub(",", "")))
    if number and number <= 1000000000 then return number end
    return nil
end
-- Labels are children of the actual slot, so Roblox moves and clips them with
-- its scrolling ancestors, even between scans. They never receive input.
local reportedUnknown = false
local function findSlots(root, seen, stats, side, nested)
    local total, uncertain = 0, false
    if not root then return total, uncertain end
    stats.roots=stats.roots+1
    if not isVisible(root) then return total, uncertain end
    stats.visibleRoots=stats.visibleRoots+1
    -- Holiday can contain category/year wrappers between the page and slots.
    -- Never search outside this named page, and cap both work and depth.
    local pending={{root,0}}
    local visited=0
    while #pending>0 and visited<4096 do
        local entry=table.remove(pending)
        local parent,depth=entry[1],entry[2]
        for _,slot in ipairs(parent:GetChildren()) do
            visited=visited+1
            if visited>4096 then break end
            local isSlot=slot:IsA("GuiObject") and slot.Name:match("^NewItem%d*$")
            if nested and not isSlot and depth<16 and (not slot:IsA("GuiObject") or slot.Visible) then
                pending[#pending+1]={slot,depth+1}
            end
        if isSlot and slot.Visible and not seen[slot] and (not nested or isVisible(slot)) then
            stats.slots=stats.slots+1
            local container=slot:FindFirstChild("Container") or slot
            -- Both observed layouts occur: ItemName inside Container or beside it.
            local itemName=container:FindFirstChild("ItemName") or slot:FindFirstChild("ItemName")
            local label=itemName and (itemName:FindFirstChild("Label") or childPath(itemName,"Frame","Label"))
            local text=getText(label)
            if container and text and text:match("%S") and visibleWithin(label,slot) then
                seen[slot]=true
                local price=resolve(text,container)
                if price == "?" and not reportedUnknown then
                    reportedUnknown=true
                    warn("MM2 values: unknown or ambiguous item example: "..text:sub(1,100).." (snapshot "..tostring(updated)..")")
                end
                if price ~= "?" then stats.mapped=stats.mapped+1 else stats.unknown=stats.unknown+1 end
                local amount=amountOf(container,slot)
                local contribution
                if amount == 0 then contribution=0
                elseif amount and price ~= "?" then contribution=tonumber(price)*amount end
                if contribution then total=total+contribution else uncertain=true end
                local display=price
                local tag=overlays[slot]
                if not tag or tag.Parent ~= slot then
                    if tag then tag:Destroy() end
                    tag=make("TextLabel",slot,{Name="MM2ValueOverlay",BackgroundTransparency=1,BorderSizePixel=0,TextColor3=Color3.fromRGB(255,210,75),TextStrokeColor3=Color3.fromRGB(0,0,0),TextStrokeTransparency=0.2,Font=Enum.Font.GothamBold,TextSize=12,TextWrapped=false,ClipsDescendants=true,Size=UDim2.new(1,-4,0,16),Position=UDim2.fromOffset(2,2),ZIndex=10000,Active=false,Selectable=false})
                    overlays[slot]=tag
                end
                tag.Text=display
            elseif side then
                uncertain=true
            end
        end
        end
    end
    return total, uncertain
end
local function showTotal(side, root, total, uncertain, seenTotals)
    if not side or not root or not isVisible(root) or not isVisible(side) then return end
    seenTotals[side]=true
    local tag=totals[side]
    if not tag or tag.Parent ~= side then
        if tag then tag:Destroy() end
        tag=make("TextLabel",side,{Name="MM2TradeTotal",BackgroundTransparency=1,BorderSizePixel=0,TextColor3=Color3.fromRGB(255,210,75),TextStrokeColor3=Color3.fromRGB(0,0,0),TextStrokeTransparency=0.2,Font=Enum.Font.GothamBold,TextSize=14,Size=UDim2.new(1,0,0,18),Position=UDim2.fromOffset(0,0),ZIndex=10000,Active=false,Selectable=false})
        totals[side]=tag
    end
    tag.Text="Total: "..tostring(total)..(uncertain and " + ?" or "")
end
