-- Preserve explicit JSON null separately from a missing value. Neither becomes
-- a price unless the snapshot already contains a numeric value.
local NULL_VALUE = "__MM2_EXPLICIT_JSON_NULL_48923__"
local function preserveNull(text)
    local out, i, quoted, escaped = {}, 1, false, false
    while i <= #text do
        local c = text:sub(i,i)
        if quoted then
            out[#out+1] = c
            if escaped then escaped=false elseif c=="\\" then escaped=true elseif c=='"' then quoted=false end
            i=i+1
        elseif c=='"' then quoted=true; out[#out+1]=c; i=i+1
        elseif text:sub(i,i+3)=='null' then out[#out+1]='"'..NULL_VALUE..'"'; i=i+4
        else out[#out+1]=c; i=i+1 end
    end
    return table.concat(out)
end
local function decode(text)
    if type(text) ~= "string" or #text == 0 then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(preserveNull(text)) end)
    if not ok or type(data) ~= "table" then return nil end
    local items = type(data.items)=="table" and data.items or data
    local count=0
    for k,v in pairs(items) do
        if type(v)=="table" and type(v.name)=="string" and v.category ~= nil then count=count+1 end
    end
    if count == 0 then return nil end
    return items, data.fetched_at, count
end
